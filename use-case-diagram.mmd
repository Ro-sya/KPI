flowchart LR
    %% Внутрішні актори
    Guest((Гість))
    Customer((Покупець))
    Admin((Адміністратор))

    %% Зовнішні актори
    PaymentSys[Платіжна система]
    DeliverySys[Служба доставки]

    %% Межа системи та прецеденти
    subgraph System ["Система інтернет-магазину"]
        US4([US-4: Реєстрація та авторизація])
        US1([US-1: Оформлення замовлення])
        US2([US-2: Скасування замовлення])
        US3([US-3: Збереження у Список бажань])
        US5([US-5: Написання та відображення відгуків])
        US6([US-6: Видалення акаунта])
        
        %% Внутрішні кроки для зв'язків
        PayProc([Оплата замовлення])
        ShipProc([Передача на доставку])
    end

    %% Ієрархія/зв'язки акторів (Покупець успадковує можл. Гостя або логіниться)
    Guest --> US4
    Guest --> US5

    Customer --> US1
    Customer --> US2
    Customer --> US3
    Customer --> US5
    Customer --> US6

    %% Зв'язки include / extend
    US1 -. "<<include>>" .-> PayProc
    US1 -. "<<include>>" .-> ShipProc
    US2 -. "<<extend>>" .-> US1

    %% Взаємодія з зовнішніми системами
    PayProc --- PaymentSys
    ShipProc --- DeliverySys

    %% Взаємодія адміністратора
    Admin --> US2