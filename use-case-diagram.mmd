graph TD
    %% Актори (Actors)
    Guest(("Гість"))
    Customer(("Покупець"))
    Admin(("Адміністратор"))
    PaymentGW(("Платіжний провайдер"))
    DeliveryAPI(("Служба доставки"))

    %% Прецеденти використання (Use Cases)
    subgraph System ["Commerce Система"]
        UC_Browse("UC-1: Перегляд каталогу, категорій і відгуків")
        UC_Wishlist("UC-2: Управління списком бажань")
        UC_Checkout("UC-3: Оформлення замовлення")
        UC_Pay("UC-4: Оплата замовлення")
        UC_Cancel("UC-5: Скасування замовлення")
        UC_ManageCatalog("UC-6: Управління каталогом та наявністю")
        UC_ManageOrders("UC-7: Управління статусами замовлення")
        UC_Auth("UC-8: Реєстрація та автентифікація")
        UC_Review("UC-9: Написання відгуку")
        UC_DeleteAccount("UC-10: Видалення акаунта")
        UC_Profile("UC-11: Управління профілем та адресами")
    end

    %% Зв'язки Гістя
    Guest --> UC_Browse
    Guest --> UC_Auth

    %% Зв'язки Покупця
    Customer --> UC_Browse
    Customer --> UC_Wishlist
    Customer --> UC_Checkout
    Customer --> UC_Cancel
    Customer --> UC_Review
    Customer --> UC_DeleteAccount
    Customer --> UC_Profile

    %% Зв'язки Адміністратора
    Admin --> UC_ManageCatalog
    Admin --> UC_ManageOrders

    %% Внутрішні зв'язки та інтеграції з зовнішніми системами
    UC_Checkout -.->|include| UC_Pay
    UC_Pay --- PaymentGW
    UC_Checkout --- DeliveryAPI
    UC_ManageOrders --- DeliveryAPI
