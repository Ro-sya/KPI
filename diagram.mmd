erDiagram
    USER {
        int id PK
        string email
        string password
        string name
        datetime created_at
    }

    USER_ADDRESS {
        int id PK
        int user_id FK
        string city
        string delivery_service
        string address_line
        boolean is_default
    }

    PRODUCT {
        int id PK
        int category_id FK
        string name
        string brand
        string color
        string description
        string image_url
        decimal price
        int stock_quantity
    }

    CATEGORY {
        int id PK
        string name
    }

    WISHLIST {
        int id PK
        int user_id FK
        int product_id FK
        boolean in_stock
    }

    ORDER {
        int id PK
        int user_id FK
        string status
        string delivery_service
        string delivery_address
        string payment_method
        string payment_status
        decimal total_amount
        datetime created_at
    }

    ORDER_ITEM {
        int id PK
        int order_id FK
        int product_id FK
        int quantity
    }

    REVIEW {
        int id PK
        int user_id FK
        int product_id FK
        int rating
        string comment
        datetime created_at
    }

    USER ||--o{ USER_ADDRESS : "has"
    USER ||--o{ ORDER : "places"
    USER ||--o{ REVIEW : "writes"
    USER ||--o{ WISHLIST : "saves"
    PRODUCT ||--o{ WISHLIST : "in"
    CATEGORY ||--o{ PRODUCT : "contains"
    PRODUCT ||--o{ REVIEW : "receives"
    ORDER ||--|{ ORDER_ITEM : "contains"
    PRODUCT ||--o{ ORDER_ITEM : "included_in"